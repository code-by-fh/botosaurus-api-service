#!/bin/sh
# Git pre-commit hook to automatically format and check code with ruff before committing.

echo "Running pre-commit ruff check and format..."

RUFF=""
if command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
elif python -m ruff --version >/dev/null 2>&1; then
    RUFF="python -m ruff"
elif python3 -m ruff --version >/dev/null 2>&1; then
    RUFF="python3 -m ruff"
else
    echo "ERROR: ruff is not installed in your Python environment!"
    echo "Please run: pip install ruff"
    exit 1
fi

# Auto-format python code in app, tests and scripts
$RUFF format app tests scripts
format_status=$?

# Run ruff check
$RUFF check app tests scripts
check_status=$?

if [ $format_status -ne 0 ] || [ $check_status -ne 0 ]; then
    echo "ERROR: ruff check or format failed. Commit aborted!"
    exit 1
fi

# Re-stage formatted files if formatting was applied
git add app/ tests/ scripts/

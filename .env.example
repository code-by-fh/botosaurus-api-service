# Every variable except API_KEYS is optional; the commented values are the defaults
# (see README, Configuration). The service refuses to start on any invalid value.

# ==========================================
# 1. API KEYS (required)
# ==========================================
# Comma-separated API keys (one per client app), each at least 32 characters.
# The service refuses to start while a key still starts with CHANGE_ME.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEYS=CHANGE_ME_APP_ONE,CHANGE_ME_APP_TWO

# Single-key alternative to API_KEYS (used only when API_KEYS is unset):
# API_KEY=CHANGE_ME_SECRET_KEY


# ==========================================
# 2. PROXY & EGRESS
# ==========================================
# Upstream proxy for requests sent with "use_proxy": true (e.g. a proxy at home reached over
# WireGuard/Tailscale, or a residential proxy). PROXY is accepted as an alias.
# Schemes: http://, https://, socks5://, socks5h://; host and an explicit port (1-65535) are
# required, credentials are allowed (http://user:pass@host:port).
# HOME_PROXY=http://100.64.0.2:8888

# Allow private, loopback and link-local targets (127.0.0.1, 10.x, 192.168.x).
# Local development only; keep false in production (SSRF protection).
# ALLOW_PRIVATE_TARGETS=false


# ==========================================
# 3. BROWSER
# ==========================================
# Chrome instances in parallel: 2 on a CX23 (2 vCPU / 4 GB), 3 on a CX33 (4 vCPU / 8 GB).
# MAX_WORKERS=2

# false: headed Chrome on Xvfb (harder to detect). true: --headless=new.
# HEADLESS=false

# Chrome executable; the image sets /usr/local/bin/chrome-launcher.
# CHROME_BIN=/usr/local/bin/chrome-launcher

# Chrome sandbox; needs user namespaces, which containers usually lack.
# BROWSER_SANDBOX=false

# Restart a browser after this many renders, or after this age in seconds (2700 = 45 minutes,
# at least 60).
# BROWSER_MAX_PAGES=150
# BROWSER_MAX_AGE_SECONDS=2700

# Browser language and timezone; must match the egress IP.
# BROWSER_LOCALE=de-DE
# BROWSER_TIMEZONE=Europe/Berlin


# ==========================================
# 4. QUEUE & CONCURRENCY
# ==========================================
# Seconds a request waits for a per-host slot and for a free browser (each).
# QUEUE_TIMEOUT_SECONDS=20

# Requests allowed to wait for a browser; beyond that 429 SERVICE_BUSY is returned at once.
# MAX_QUEUE_SIZE=8

# Simultaneous requests per target host, HTTP fast path and browser renders alike.
# MAX_CONCURRENCY_PER_HOST=2


# ==========================================
# 5. HTTP FAST PATH & VERDICTS
# ==========================================
# Serve verified site sections over plain HTTP (curl_cffi) instead of the browser.
# HTTP_FIRST_ENABLED=true

# Matches of different pages (or of one page over time, see next setting) needed before a
# section is served over HTTP.
# VERDICT_MIN_SAMPLES=2

# Minimum spacing in seconds of repeated matches of one page, so a single-page section such as
# a homepage can earn the fast path (at least 60, below VERDICT_TTL_SECONDS).
# VERDICT_SAME_PAGE_INTERVAL_SECONDS=600

# Lifetime in seconds of a learned verdict (21600 = 6 hours, at least 60).
# VERDICT_TTL_SECONDS=21600

# Share of the browser's words and text length the HTTP document must contain (0-1).
# MIN_TEXT_COVERAGE=0.9

# Size cap in bytes for HTTP responses (larger ones go to the browser). A browser render whose
# document has more characters fails with 502 RESPONSE_TOO_LARGE.
# MAX_RESPONSE_BYTES=10485760


# ==========================================
# 6. READINESS LEARNING (section profiles, late content)
# ==========================================
# Seconds a returned page is watched in the background for content that appears late, so later
# renders of the site section wait long enough (0-30, 0 disables the watch). The watch holds its
# browser only while no request waits. Only a cleanly watched render can verify a section for
# the HTTP fast path, so 0 also means no section ever becomes HTTP-sufficient.
# LATE_CONTENT_OBSERVE_SECONDS=10

# Share of renders watched once a section had its first 2 watched renders (0-1).
# PROFILE_OBSERVE_SAMPLE_RATE=0.05

# Lifetime in seconds of a learned section profile, counted from its first render
# (60-604800, 21600 = 6 hours).
# PROFILE_TTL_SECONDS=21600


# ==========================================
# 7. CLEARANCE COOKIE REUSE
# ==========================================
# Reuse anti-bot clearance cookies (aws-waf-token, cf_clearance, ...) between browser renders of
# the same site on the same egress route, so a solved challenge is not re-run on every request.
# CLEARANCE_REUSE=true

# Longest reuse in seconds (1-3600; below the typical 300 s token immunity). A shorter cookie
# expiry wins.
# CLEARANCE_MAX_AGE_SECONDS=240


# ==========================================
# 8. LIVE VIEW (VNC)
# ==========================================
# Start x11vnc and noVNC, served at https://<your-domain>/vnc (Basic auth, password = API key).
# Headed mode only: the service refuses to start together with HEADLESS=true.
# ENABLE_VNC=false

# VNC password, required with ENABLE_VNC=true (VNC uses at most 8 characters).
# VNC_PASSWORD=CHANGE_ME

# Container-internal port of websockify on 127.0.0.1; never published, /vnc relays it.
# VNC_PORT=6080


# ==========================================
# 9. API DOCUMENTATION & CLIENT ADDRESSES
# ==========================================
# Serve /docs, /redoc and /openapi.json behind HTTP Basic auth (any username, password = API key).
# false: these paths return 404.
# ENABLE_DOCS=false

# Reverse proxies whose X-Forwarded-For identifies the client for the failed-login lockout
# (comma-separated IPs or CIDR ranges). Leave empty when clients connect directly. Behind a
# reverse proxy list only the proxy's own address as the container sees it, never a whole
# network: every host in a listed range could choose its client address. For a proxy on the
# Docker host this is the gateway of the compose network (see `docker network inspect`).
# TRUSTED_PROXY_IPS=<address of your reverse proxy>


# ==========================================
# 10. LOGGING
# ==========================================
# DEBUG | INFO | WARNING | ERROR (case-insensitive; any other value stops the service).
# LOG_LEVEL=INFO


# ==========================================
# 11. DOCKER COMPOSE (read by docker-compose.yml, not by the service)
# ==========================================
# Host address the API port 8000 is published on. Keep 127.0.0.1 when the reverse proxy runs on
# the same host; Docker's published ports bypass host firewalls. When the proxy runs elsewhere,
# set the private interface address it reaches, never 0.0.0.0.
# API_BIND=127.0.0.1

# Container limits, sized for a Hetzner CX23 (2 vCPU / 4 GB). MEM_LIMIT includes the 512 MB /tmp
# tmpfs; CPU_LIMIT must not exceed the host's vCPUs. CX33 (4 vCPU / 8 GB): MEM_LIMIT=6g,
# CPU_LIMIT=3.5, MAX_WORKERS=3.
# MEM_LIMIT=3g
# CPU_LIMIT=1.8

# === API KEYS (required) ===
# One key per client app, comma-separated. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEYS=CHANGE_ME_APP_ONE,CHANGE_ME_APP_TWO

# === PROXY (optional) ===
# Egress for requests with "use_proxy": true, e.g. a home proxy reached via
# WireGuard/Tailscale. Credentials are supported: http://user:pass@host:port
# HOME_PROXY=http://100.64.0.2:8888

# === BROWSER IDENTITY ===
# Must match the location of the egress IP(s).
# BROWSER_LOCALE=de-DE
# BROWSER_TIMEZONE=Europe/Berlin

# === DEBUG VIEW ===
# ENABLE_VNC=true requires VNC_PASSWORD (VNC uses at most 8 characters).
# ENABLE_VNC=false
# VNC_PASSWORD=CHANGE_ME
#
# NOVNC_PREFIX routes noVNC through the API port (no direct port 6080 needed).
# Set this when port 6080 is not reachable from the browser (e.g. behind a
# reverse proxy). The browser then loads /novnc/ instead of :6080/.
# NOVNC_PREFIX=/novnc

# === LOGGING ===
# DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO

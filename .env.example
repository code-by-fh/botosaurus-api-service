# ==========================================
# 1. API KEYS (required)
# ==========================================
# Comma-separated list of valid API keys (one per client app).
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEYS=CHANGE_ME_APP_ONE,CHANGE_ME_APP_TWO

# Single key fallback (alternative to API_KEYS):
# API_KEY=CHANGE_ME_SECRET_KEY


# ==========================================
# 2. PROXY & EGRESS (optional)
# ==========================================
# Upstream proxy for requests sent with "use_proxy": true (e.g. WireGuard/Tailscale or residential proxy).
# Supported schemes: http://, https://, socks5://, socks5h:// (credentials allowed: http://user:pass@host:port)
# HOME_PROXY=http://100.64.0.2:8888

# Allow reaching private, loopback, or link-local targets (127.0.0.1, 10.x, 192.168.x).
# WARNING: Keep false in production for SSRF security; enable only for local testing.
# ALLOW_PRIVATE_TARGETS=false


# ==========================================
# 3. BROWSER IDENTITY & WORKERS
# ==========================================
# Number of Chrome instances running in parallel (2 for 4 GB RAM / 2 vCPU, 3-4 for 8 GB RAM / 4 vCPU).
# MAX_WORKERS=2

# Headed vs Headless mode.
# false: Headed Chrome on Xvfb (recommended, harder to detect)
# true:  Headless Chrome (--headless=new)
# HEADLESS=false

# Chrome executable path (autodetected in container image).
# CHROME_BIN=/usr/local/bin/chrome-launcher

# Run Chrome sandbox (requires user namespaces, usually false inside containers).
# BROWSER_SANDBOX=false

# Recycle browser instance after rendering N pages (prevents memory leaks).
# BROWSER_MAX_PAGES=150

# Recycle browser instance after N seconds of uptime (default: 2700 = 45 minutes).
# BROWSER_MAX_AGE_SECONDS=2700

# Browser locale and timezone (must match the egress IP location for realistic fingerprints).
# BROWSER_LOCALE=de-DE
# BROWSER_TIMEZONE=Europe/Berlin


# ==========================================
# 4. QUEUE & CONCURRENCY CONTROL
# ==========================================
# Maximum seconds a request waits in queue for an available browser slot.
# QUEUE_TIMEOUT_SECONDS=20.0

# Maximum number of requests allowed to wait in queue before returning HTTP 429 SERVICE_BUSY.
# MAX_QUEUE_SIZE=8

# Maximum simultaneous browser renders allowed per target domain/host.
# MAX_CONCURRENCY_PER_HOST=2


# ==========================================
# 5. HTTP FAST PATH & VERIFICATION
# ==========================================
# Enable browserless HTTP fast path (uses curl_cffi for proven JavaScript-free pages).
# HTTP_FIRST_ENABLED=true

# Lifetime (in seconds) of a learned section verdict (default: 21600 = 6 hours).
# VERDICT_TTL_SECONDS=21600

# Minimum number of distinct matching URL samples needed before trusting HTTP fast path for a section.
# VERDICT_MIN_SAMPLES=2

# Text match threshold (0.0 to 1.0) between HTTP and browser render (default: 0.9 = 90%).
# MIN_TEXT_COVERAGE=0.9

# Maximum response size in bytes for HTTP fast path (larger responses fallback to browser).
# MAX_RESPONSE_BYTES=10485760

# Reuse anti-bot clearance cookies (aws-waf-token, cf_clearance, ...) between browser renders of
# the same site on the same egress route, so a solved challenge is not re-run on every request.
# CLEARANCE_REUSE=true

# Maximum seconds a stored clearance cookie is reused (1-3600, default 240; below the typical
# 300 s token immunity). A cookie's own shorter expiry always wins.
# CLEARANCE_MAX_AGE_SECONDS=240


# ==========================================
# 6. DEBUG & LIVE VIEW (VNC)
# ==========================================
# Enable live browser view via x11vnc and noVNC (headed mode only).
# ENABLE_VNC=false

# Password for VNC authentication (required if ENABLE_VNC=true, max 8 characters).
# VNC_PASSWORD=CHANGE_ME

# Container-internal port of the noVNC server (websockify, bound to 127.0.0.1).
# It is never published; open https://<your-domain>/vnc instead (Basic auth, password = API key).
# VNC_PORT=6080


# ==========================================
# 7. API DOCUMENTATION & CLIENT ADDRESSES
# ==========================================
# Serve /docs, /redoc and /openapi.json behind HTTP Basic auth (any username, password = API key).
# false: these paths return 404.
# ENABLE_DOCS=false

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs or CIDR ranges).
# Used to identify clients for the failed-login lockout. Leave empty when clients connect directly;
# behind a reverse proxy, list its address or all clients share the proxy's lockout.
# TRUSTED_PROXY_IPS=172.18.0.0/16


# ==========================================
# 8. LOGGING
# ==========================================
# Log verbosity: DEBUG | INFO (default) | WARNING | ERROR
# LOG_LEVEL=INFO
